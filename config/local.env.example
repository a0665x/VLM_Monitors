# Copy to .env. WebUI engine settings persist in temp/engine-settings.json and override these defaults.
VLM_BACKEND=ollama
VLM_MODEL=qwen2.5vl:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLM_TIMEOUT=120
VLM_MAX_TOKENS=128
VLM_TEMPERATURE=0
VLM_FRAME_MAX_EDGE=1024
VIDEO_DEVICE=/dev/video0
# Optional: set both dimensions only when your camera requires an explicit mode.
# CAMERA_WIDTH=1280
# CAMERA_HEIGHT=720
CAMERA_FPS=30
CAMERA_EXPOSURE_MODE=auto
VIDEO_ENCODER=software
MEDIAMTX_CONFIG=./config/mediamtx.local.yml
SERVICE_BIND=127.0.0.1:5000
# Google login (optional). Register this exact redirect URI in Google Cloud:
# https://<your-service-host>/auth/google/callback
# AUTH_PUBLIC_URL=https://<your-service-host>
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AUTH_ALLOWED_EMAILS=viewer@example.com,another@example.com
# Account data and archives stay on this host and are ignored by git.
ARCHIVE_RETENTION_DAYS=7
ARCHIVE_QUOTA_MB=1024

# Entire archive budget and disk free-space floor (MiB)
ARCHIVE_TOTAL_MB=10240
ARCHIVE_MIN_FREE_MB=1024
# Optional external disk / NAS mount
# ARCHIVE_DIR=/mnt/vlm/archive

# Keep AI models warm after the last analysis, then release GPU memory.
MODEL_IDLE_SECONDS=300
